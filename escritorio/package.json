{
  "name": "jse-captura",
  "productName": "JSE Captura",
  "version": "0.1.1",
  "description": "Graba la pantalla de Windows en MP4 y la copia al NAS",
  "main": "src/main.js",
  "private": true,
  "author": "JSE",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:carpeta": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "mx.jse.captura",
    "productName": "JSE Captura",
    "files": [
      "src/**",
      "recursos/**",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "recursos/icono.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "JSE Captura",
      "language": "3082",
      "artifactName": "JSE-Captura-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "JSE-Captura-Portatil-${version}.${ext}"
    }
  }
}