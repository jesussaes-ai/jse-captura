# Copia este archivo a .env y ajusta. NUNCA subas .env a GitHub.

# Cuenta de servicio con la que cada equipo (PC, Android, iPhone) se vincula una vez.
JSE_USUARIO=jse-captura
JSE_CONTRASENA=cambia-esta-contraseña-larga

# IP del NAS en tu red (el puerto 8790 solo escucha ahí). Ejemplo de tu red: 192.168.100.249
JSE_IP_LAN=192.168.100.249

# Carpeta del NAS donde se guardan los MP4 (ruta del host del NAS).
# Recomendado: la biblioteca que indexa Fotos JSE → los videos salen en la galería sin duplicarse.
JSE_CARPETA_NAS=/volume1/spark/Fotos-JSE/biblioteca/JSE Captura

# Usuario/grupo dueños de esa carpeta en el NAS (en UGOS: `id <usuario>` por SSH).
PUID=1000
PGID=10

# Fotos JSE: misma-carpeta | copiar | no
JSE_FOTOS_MODO=misma-carpeta
# Solo para modo copiar (ruta DENTRO del contenedor; añade el volumen en docker-compose.yml):
# JSE_FOTOS_CARPETA=/fotos-jse-importar
# Para pedir escaneo y comprobar "Visible en Fotos JSE" (el contenedor debe alcanzarla, p. ej. por Tailscale):
JSE_FOTOS_URL=https://dgx-spark.tail8c4fdf.ts.net:8450

# Límites
JSE_MAX_ARCHIVO_GB=20
JSE_RESERVA_LIBRE_GB=2
JSE_HORAS_INCOMPLETOS=72
